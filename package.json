{
  "name": "file-funeral",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "npm run test:rust && npm run test:frontend",
    "test:rust": "cd src-tauri && cargo test -- --test-threads=1",
    "test:rust:verbose": "cd src-tauri && cargo test -- --nocapture --test-threads=1",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test:frontend:ui": "vitest --ui",
    "lint": "npm run lint:rs && npm run lint:ts",
    "lint:rs": "cd src-tauri && cargo clippy -- -D warnings",
    "lint:ts": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "npm run lint:ts -- --fix && cd src-tauri && cargo fmt",
    "format": "cd src-tauri && cargo fmt && npm run lint:ts -- --fix",
    "db:inspect": "./scripts/inspect_db.sh",
    "db:shell": "sqlite3 ~/.file-funeral/sync_history.db",
    "check:size": "du -sh . && echo '\n--- Directory Breakdown ---' && du -sh src-tauri/target node_modules dist 2>/dev/null | sort -h || echo 'No build artifacts found'",
    "clean": "npm run clean:target && npm run clean:node_modules && npm run clean:dist && echo '\n✓ Cleanup complete. Run npm install to restore dependencies.'",
    "clean:target": "rm -rf src-tauri/target && echo '✓ Removed src-tauri/target'",
    "clean:node_modules": "rm -rf node_modules && echo '✓ Removed node_modules'",
    "clean:dist": "rm -rf dist && echo '✓ Removed dist'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.25",
    "jsdom": "^27.3.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  }
}
