{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "file-funeral",
  "version": "1.0.0",
  "identifier": "com.ohr486.file-funeral",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "file-funeral",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ohr486",
    "category": "Utility",
    "shortDescription": "Cloud file synchronization desktop application",
    "longDescription": "file-funeral is a fast and secure desktop application for backing up and synchronizing local files with AWS S3. Designed for bidirectional file synchronization across multiple PCs with Dropbox-like simplicity.",
    "copyright": "Copyright (c) 2026 ohr486",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  }
}
